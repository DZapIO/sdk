# yarn.lock is NOT ignored by accident any more: this package is pnpm-managed
# and commits pnpm-lock.yaml so that installs are reproducible. A stray
# yarn.lock alongside it produces two different dependency graphs for the same
# commit -- which is how three copies of ethers ended up installed at once and
# silently broke `instanceof Signer` in the signing path.
yarn.lock
